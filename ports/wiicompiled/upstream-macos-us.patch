+namespace {
+// Mesa's GLSL shader cache (switch-mesa rebuilt with it on; see ports/mesa-switch) has no
+// directory on the Switch and goes through EGL_ANDROID_blob_cache into aurora's SQLite cache
+// instead, so a GL program compiled once (GLSL compile, link, TGSI) is reused on later launches.
+// Keys get a "mesa" prefix so they can't meet Dawn's. Android get semantics: return the size,
+// fill the buffer only when it fits; the SQLite loader fills only on an exact size, so probe first.
+std::atomic<uint32_t> g_mesaBlobHits{0}, g_mesaBlobMisses{0}, g_mesaBlobStores{0};
+void log_mesa_blob_stats() {
+  const uint32_t h = g_mesaBlobHits.load(), m = g_mesaBlobMisses.load(), s = g_mesaBlobStores.load();
+  if (((h + m + s) & 63u) == 0) {
+    std::fprintf(stderr, "[dawn-gl] mesa shader cache: hits %u, misses %u, stored %u\n", h, m, s);
+  }
+}
+struct MesaKey {
+  unsigned char bytes[4 + 64];
+  size_t size;
+};
+bool mesa_key(const void* key, EGLsizeiANDROID keySize, MesaKey& out) {
+  if (key == nullptr || keySize <= 0 || static_cast<size_t>(keySize) > sizeof(out.bytes) - 4) {
+    return false;
+  }
+  std::memcpy(out.bytes, "mesa", 4);
+  std::memcpy(out.bytes + 4, key, static_cast<size_t>(keySize));
+  out.size = 4 + static_cast<size_t>(keySize);
+  return true;
+}
+void mesa_blob_set(const void* key, EGLsizeiANDROID keySize, const void* value, EGLsizeiANDROID valueSize) {
+  MesaKey k;
+  if (!mesa_key(key, keySize, k) || value == nullptr || valueSize <= 0) {
+    return;
+  }
+  aurora::webgpu::store_to_cache(k.bytes, k.size, value, static_cast<size_t>(valueSize), nullptr);
+  g_mesaBlobStores.fetch_add(1, std::memory_order_relaxed);
+  log_mesa_blob_stats();
+}
+EGLsizeiANDROID mesa_blob_get(const void* key, EGLsizeiANDROID keySize, void* value, EGLsizeiANDROID valueSize) {
+  MesaKey k;
+  if (!mesa_key(key, keySize, k)) {
+    return 0;
+  }
+  const size_t found = aurora::webgpu::load_from_cache(k.bytes, k.size, nullptr, 0, nullptr);
+  if (found == 0 || value == nullptr || valueSize <= 0 || found > static_cast<size_t>(valueSize) ||
+      aurora::webgpu::load_from_cache(k.bytes, k.size, value, found, nullptr) != found) {
+    g_mesaBlobMisses.fetch_add(1, std::memory_order_relaxed);
+    log_mesa_blob_stats();
+    return 0;
+  }
+  g_mesaBlobHits.fetch_add(1, std::memory_order_relaxed);
+  log_mesa_blob_stats();
+  return static_cast<EGLsizeiANDROID>(found);
+}
+void install_mesa_blob_cache(EGLDisplay display) {
+  const char* exts = display != EGL_NO_DISPLAY ? eglQueryString(display, EGL_EXTENSIONS) : nullptr;
+  if (exts == nullptr || std::strstr(exts, "EGL_ANDROID_blob_cache") == nullptr) {
+    std::fprintf(stderr, "[dawn-gl] mesa shader cache: unavailable (EGL_ANDROID_blob_cache missing)\n");
+    return;
+  }
+  if (std::getenv("AURORA_NO_MESA_SHADER_CACHE") != nullptr) {
+    std::fprintf(stderr, "[dawn-gl] mesa shader cache: off (AURORA_NO_MESA_SHADER_CACHE)\n");
+    return;
+  }
+  const auto setFuncs =
+      reinterpret_cast<PFNEGLSETBLOBCACHEFUNCSANDROIDPROC>(eglGetProcAddress("eglSetBlobCacheFuncsANDROID"));
+  if (setFuncs == nullptr) {
+    std::fprintf(stderr, "[dawn-gl] mesa shader cache: eglSetBlobCacheFuncsANDROID not found\n");
+    return;
+  }
+  setFuncs(display, mesa_blob_set, mesa_blob_get);
+  // Mesa now exposes a program binary format too; Dawn's own binary cache (keyed by GLSL) would
+  // store every program a second time, so it stays off unless env.txt sets it explicitly.
+  setenv("DAWN_GL_NO_PROGRAM_BINARY", "1", 0);
+  std::fprintf(stderr, "[dawn-gl] mesa shader cache: on (stored in the graphics cache database)\n");
+}
+} // namespace
+#endif
