+                svcGetInfo(&totalMem, InfoType_TotalMemorySize, CUR_PROCESS_HANDLE, 0);
+                const struct mallinfo mi = mallinfo();
+                size_t efbCopies = 0;
+                uint32_t efbLargest = 0;
+                GxEfbCopyDestinationStats(efbCopies, efbLargest);
+                std::fprintf(stderr, "[mem] uptime %.0f s: process %.1f / %.1f MiB, malloc in use %.1f MiB of arena %.1f MiB, "
+                             "efb copy destinations %zu (largest %u bytes)\n",
+                             armTicksToNs(now - start) / 1e9, usedMem / 1048576.0, totalMem / 1048576.0,
+                             mi.uordblks / 1048576.0, mi.arena / 1048576.0, efbCopies, efbLargest);
+            }
+            for (int sl = 0; sl < 2; ++sl) {
+                put(std::snprintf(line, sizeof(line), "slot %d total %llu\n", sl,
+                                  static_cast<unsigned long long>(totals[sl])));
+                std::vector<std::pair<uint32_t, Key>> v;
+                v.reserve(counts[sl].size());
+                for (const auto& [k, c] : counts[sl]) v.emplace_back(c, k);
+                std::sort(v.begin(), v.end(), [](const auto& x, const auto& y) { return x.first > y.first; });
+                for (size_t i = 0; i < v.size() && i < 2500; ++i) {
+                    int n = std::snprintf(line, sizeof(line), "%d %u", sl, v[i].first);
+                    for (uint64_t a : v[i].second)
+                        n += std::snprintf(line + n, sizeof(line) - n, " 0x%llx", static_cast<unsigned long long>(a));
