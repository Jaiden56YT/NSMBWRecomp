+    SwitchSqliteSelfTest();
+    SwitchCpuClockBoost();
+    SwitchStationStart();
+    std::set_terminate([] {
+        const char* what = "(no exception)";
+        if (auto e = std::current_exception()) {
+            try { std::rethrow_exception(e); }
+            catch (const std::exception& ex) { what = ex.what(); }
+            catch (...) { what = "(non-std exception)"; }
+        }
+        std::fprintf(stderr, "[switch] std::terminate: %s\n", what);
+        std::fflush(nullptr);
+        if (g_switchStationMode) SwitchStationRestart("std::terminate");
+        SwitchCpuClockRestore();
+        std::abort();
+    });
+    std::printf("[switch] NSMBW (NSMBWiicompiled port) starting\n");
+    std::fflush(stdout);
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 64u << 20);
+    static int result = 0;
+    pthread_t thread;
+    if (pthread_create(&thread, &attr, [](void*) -> void* {
+            svcSetThreadCoreMask(CUR_THREAD_HANDLE, 0, 1u << 0);  // game on core 0; aurora workers on 1 and 2
+            SwitchProfilerRegisterThread(0);
+            result = NsmbwMain();
+            return nullptr;
+        }, nullptr) != 0) {
+        std::printf("[switch] could not start the game thread\n");
+        return 1;
+    }
+    pthread_join(thread, nullptr);
+    std::fflush(nullptr);
+    return result;
+}
