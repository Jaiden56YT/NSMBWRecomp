+// ---- The file select's Mods button ---------------------------------------------------------------
+//
+// dFileSelect_c (layout fileSelectBase_18) has two buttons under the save files: Free Mode
+// (N_Multi_00 > N_multiButton_00, green) and Coin Battle (N_MultiCoin_00 > N_multiCoin_00,
+// yellow), each a null pane with the button's pictures and texts under it, a group (F00_multi /
+// F01_coinBattle) and tracks in the six *Multi animations. Mods is a third button after them: a
+// copy of Coin Battle's subtree under new names, in group F02_mods, with renamed copies of its
+// tracks. The game code that drives it is ports/wiicompiled/native_us/nsmbw_file_select_mods.cpp.
+//
+// Two things differ from a plain clone:
+//  - Colour. The button colours are pane vertex colours (the base gradient), material colour
+//    registers (the checker pattern and its highlight) and the animations' colour tracks, which
+//    move between an idle and a highlighted colour. Swapping red and blue everywhere in the copy
+//    - panes, its own copies of the materials, and the copied tracks (by target, so the animation
+//    keeps its timing) - turns the yellow-orange button into a cyan-blue one that highlights the
+//    same way. The checker uses Free Mode's "?" mask (immsk_check_01) instead of coins.
+//  - Materials. Colour tracks address a material by name, and a cloned pane still points at its
+//    original's material, so without copies Mods would light up whenever Coin Battle did. Each
+//    picture and text pane of the copy gets its own material, named after the pane.
+// Layout: the animations key only the inner panes' scale, so the three buttons are placed and
+// sized through the outer null panes. The row is 2 * kFileSelectStep wide; at full size and 16:9
+// it would reach past 4:3's 304-unit half width, so 4:3 uses a smaller row.
+
+// Material table (mat1): count at +8, entry offsets (from the section start) from +12. An entry is
+// its name (20 bytes), colour registers c0..c2 (GXColorS10, 8 bytes each) from +20, konst colours
+// from +44, flags at +60 (texture map count in the low nibble), texture maps (index, wrap s, wrap t)
+// from +64. Picture panes keep their material index at +0x5C, text panes at +0x50.
+size_t FindSection(Sectioned& l, const char* magic) {
+    for (size_t i = 0; i < l.sections.size(); ++i) {
+        if (Magic(l.sections[i]) == magic) return i;
+    }
+    throw Failure{std::string("missing section ") + magic};
+}
+
+std::vector<Bytes> MaterialEntries(const Bytes& mat) {
+    const uint16_t count = Get16(mat, 8);
+    std::vector<Bytes> entries;
+    for (uint16_t i = 0; i < count; ++i) {
+        const uint32_t start = Get32(mat, 12 + 4 * i);
+        const uint32_t end = i + 1 < count ? Get32(mat, 12 + 4 * (i + 1)) : uint32_t(mat.size());
+        Require(start < end && end <= mat.size(), "bad mat1");
+        entries.emplace_back(mat.begin() + start, mat.begin() + end);
+    }
+    return entries;
+}
+
+Bytes WriteMaterials(const Bytes& oldHeader, const std::vector<Bytes>& entries) {
+    Bytes out(oldHeader.begin(), oldHeader.begin() + 12);
+    out.resize(12 + 4 * entries.size(), 0);
+    for (size_t i = 0; i < entries.size(); ++i) {
+        Put32(out, 12 + 4 * i, uint32_t(out.size()));
+        out.insert(out.end(), entries[i].begin(), entries[i].end());
+    }
+    Put16(out, 8, uint16_t(entries.size()));
+    Put32(out, 4, uint32_t(out.size()));
+    return out;
+}
