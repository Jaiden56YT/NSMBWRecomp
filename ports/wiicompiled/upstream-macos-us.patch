diff --git a/runtime/src/guest_flat_memory_switch.cpp b/runtime/src/guest_flat_memory_switch.cpp
new file mode 100644
index 0000000..a1354eb
--- /dev/null
+++ b/runtime/src/guest_flat_memory_switch.cpp
@@ -0,0 +1,86 @@
+// Guest memory on the Nintendo Switch (libnx).
+//
+// The PC builds reserve a 4 GiB address range and map each guest region into it twice (a
+// protected guest view plus a host alias), with page protections driving MMIO, deferred EFB
+// reads and executable-write guards. Horizon offers none of that to homebrew, so here guest
+// memory is one heap block and translated code reaches it through a 16-entry table indexed by
+// the top address nibble (see SwitchFlatHost in guest_flat_memory.h):
+//   0x0/0x8/0xC -> MEM1 slot (32 MiB: 24 MiB MEM1 + the 2 MiB Kamek overlay at 0x81800000)
+//   0x1/0x9/0xD -> MEM2 slot (Memory::kMem2Size)
+//   0xE         -> locked cache slot (2 MiB, as the PC build backs it)
+//   anything else -> a 64-byte scratch area with mask 0 (stray accesses land there harmlessly)
+// MMIO never reaches this path: FlatMmioNeedsPolicy sends it to the checked accessors first.
+// Page-protection features are no-ops: there is no fault interception on the Switch.
+#if defined(__SWITCH__)
+#include "guest_flat_memory.h"
+#include "memory.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+
+namespace GuestFlat {
+
+SwitchSegment g_switchSegments[16];
+
+namespace {
+constexpr uint32_t kMem1Slot = 0x02000000u;
+constexpr uint32_t kLockedCacheSlot = 0x00200000u;
+uint8_t* g_block = nullptr;
+size_t g_blockSize = 0;
+alignas(64) uint8_t g_scratch[64];
+bool g_active = false;
+
+uint32_t SlotFor(uint32_t address, uint32_t& slotSize) {
+    switch (address >> 28) {
+    case 0x0: case 0x8: case 0xC: slotSize = kMem1Slot; return 0;
+    case 0x1: case 0x9: case 0xD: slotSize = static_cast<uint32_t>(Memory::kMem2Size); return kMem1Slot;
+    case 0xE: slotSize = kLockedCacheSlot; return kMem1Slot + static_cast<uint32_t>(Memory::kMem2Size);
+    default: slotSize = 0; return 0;
+    }
+}
+}  // namespace
+
+bool IsActive() { return g_active; }
+
+void Initialize(const std::vector<RegionRequest>& regions) {
+    if (!g_block) {
+        g_blockSize = kMem1Slot + Memory::kMem2Size + kLockedCacheSlot;
+        g_block = static_cast<uint8_t*>(aligned_alloc(0x10000, g_blockSize));
+        if (!g_block) throw std::runtime_error("Switch: could not allocate guest memory");
+    }
+    std::memset(g_block, 0, g_blockSize);
+    for (int i = 0; i < 16; i++) g_switchSegments[i] = SwitchSegment{g_scratch, 0u};
+    for (uint32_t nib = 0; nib < 16; nib++) {
+        uint32_t size = 0;
+        const uint32_t offset = SlotFor(nib << 28, size);
+        if (size) g_switchSegments[nib] = SwitchSegment{g_block + offset, size - 1u};
+    }
+    for (const auto& r : regions) {
+        uint32_t size = 0;
+        SlotFor(r.base, size);
+        if (!size || (r.base & 0x0FFFFFFFu) + r.size > size)
+            std::fprintf(stderr, "[memory] Switch: region 0x%08X (+0x%llX) does not fit its slot\n", r.base,
+                         static_cast<unsigned long long>(r.size));
+    }
+    std::printf("[memory] Switch guest memory: %zu MiB block, %zu regions\n", g_blockSize >> 20, regions.size());
+    g_active = true;
+}
+
+uint8_t* HostPointer(uint32_t guestAddress) {
+    uint32_t size = 0;
+    const uint32_t offset = SlotFor(guestAddress, size);
+    if (!size || (guestAddress & 0x0FFFFFFFu) >= size) return nullptr;
+    return g_block + offset + (guestAddress & 0x0FFFFFFFu);
+}
