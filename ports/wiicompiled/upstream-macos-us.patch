+// In the colour tracks of the entries named in `names`, red and blue trade places: RLVC targets
+// 0..15 are the corners' r, g, b, a (16 is the pane's alpha), RLMC targets come in fours (material
+// colour, c0..c2, konst). Swapping the target bytes keeps every key.
+void SwapTrackRedBlue(Sectioned& a, const std::vector<std::string>& names) {
+    for (Bytes& sec : a.sections) {
+        if (Magic(sec) != "pai1") continue;
+        const size_t table = Get32(sec, 16);
+        for (uint16_t e = 0, n = Get16(sec, 14); e < n; ++e) {
+            const size_t entry = Get32(sec, table + e * 4u);
+            if (std::find(names.begin(), names.end(), Name(sec, entry, 20)) == names.end()) continue;
+            for (uint8_t t = 0, tags = sec[entry + 20]; t < tags; ++t) {
+                const size_t tag = entry + Get32(sec, entry + 24 + t * 4u);
+                const std::string kind(sec.begin() + tag, sec.begin() + tag + 4);
+                if (kind != "RLVC" && kind != "RLMC") continue;
+                for (uint8_t g = 0, groups = sec[tag + 4]; g < groups; ++g) {
+                    uint8_t& target = sec[tag + Get32(sec, tag + 8 + g * 4u) + 1];
+                    if (kind == "RLVC" && target >= 16) continue;
+                    if (target % 4 == 0) target += 2;
+                    else if (target % 4 == 2) target -= 2;
+                }
+            }
+        }
+    }
+}
