-﻿cmake_minimum_required(VERSION 3.16)
+cmake_minimum_required(VERSION 3.16)
 project(mkw_recompiled)
 
-if((NOT (WIN32 AND MINGW)) AND (NOT CMAKE_SYSTEM_NAME STREQUAL "Linux"))
-    message(FATAL_ERROR "WiiCompiled requires Windows (LLVM-MinGW) or native Linux")
+# Hosts: Windows (LLVM-MinGW) and Linux on x86-64 upstream; this tree also builds for
+# macOS and other ARM64 hosts (x86 SIMD via SIMDe, see include/isa/host_simd.h).
+if(NINTENDO_SWITCH)
+    # devkitA64 (GCC). The Clang-only spots in the ISA headers have GCC fallbacks.
+    set(MKW_SWITCH_DEPS "${CMAKE_CURRENT_LIST_DIR}/../../" CACHE PATH "third_party dir with dawn-switch/ and sdl3-switch/")
+    set(_dawn "${MKW_SWITCH_DEPS}/dawn-switch")
+    add_library(dawn::webgpu_dawn STATIC IMPORTED GLOBAL)
+    set_target_properties(dawn::webgpu_dawn PROPERTIES
+        IMPORTED_LOCATION "${_dawn}/build/src/dawn/native/libwebgpu_dawn.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${_dawn}/dawn/include;${_dawn}/build/gen/include"
+        INTERFACE_COMPILE_DEFINITIONS "EGL_NO_PLATFORM_SPECIFIC_TYPES")
+    set(Dawn_FOUND TRUE)
+    set(AURORA_DAWN_PROVIDER "system" CACHE STRING "" FORCE)
+    set(AURORA_SDL3_PROVIDER "system" CACHE STRING "" FORCE)
+    set(SDL3_DIR "${MKW_SWITCH_DEPS}/sdl3-switch/install/lib/cmake/SDL3" CACHE PATH "" FORCE)
+    set(AURORA_ENABLE_CARD OFF CACHE BOOL "" FORCE)
+    # Tracy's client always compiles a platform file the Switch lacks; with profiling off its
+    # macros are no-ops, so provide the headers only.
+    include(FetchContent)
+    FetchContent_Declare(tracy
+        URL https://github.com/wolfpld/tracy/archive/a64b9a20294d59421a2f57aeca3c6383d8c48169.tar.gz
+        URL_HASH SHA256=24d342b5127d7f659dc3cf94f24347b348cc736f25b17a691fd7f69541937658
+        SOURCE_SUBDIR none-headers-only)
+    FetchContent_MakeAvailable(tracy)
+    add_library(TracyClient INTERFACE)
+    target_include_directories(TracyClient INTERFACE "${tracy_SOURCE_DIR}/public")
+    # aurora's abseil, pre-patched for libnx (no ELF image, UTC time zone, no signal masks)
+    set(FETCHCONTENT_SOURCE_DIR_ABSEIL-CPP "${MKW_SWITCH_DEPS}/abseil-20240722-switch" CACHE PATH "" FORCE)
+    # devkitPro portlibs (EGL, GL) for aurora's Switch surface code
+    include_directories(SYSTEM "$ENV{DEVKITPRO}/portlibs/switch/include")
+elseif(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+    message(FATAL_ERROR "WiiCompiled requires a 64-bit Clang")
 endif()
-if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR
