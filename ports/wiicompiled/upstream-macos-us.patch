+uint16_t TextureIndex(Sectioned& l, const std::string& name) {
+    const Bytes& txl = l.sections[FindSection(l, "txl1")];
+    for (uint16_t i = 0, n = Get16(txl, 8); i < n; ++i) {
+        const uint32_t at = 12 + Get32(txl, 12 + 8 * i);
+        if (Name(txl, at, 64) == name) return i;
+    }
+    throw Failure{"missing texture " + name};
+}
