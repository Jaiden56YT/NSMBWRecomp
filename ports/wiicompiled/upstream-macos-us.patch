+// libnx leaves newlib's __syscall_thread_detach unimplemented, so pthread_detach returns ENOSYS
+// and every std::thread::detach() throws (the startup log-flush thread aborted the app).
+// A detached thread is queued here; a reaper polls each kernel handle and joins it once it
+// has exited, which frees its stack. libnx's pthread_t points at its kernel Thread.
+#include <switch.h>
+#include <pthread.h>
+#include <vector>
+extern "C" void* __syscall_thread_join(struct __pthread_t* thread);
+namespace {
+Mutex g_detachLock;
+std::vector<struct __pthread_t*>* g_detached;
+bool g_reaperStarted;
+void* ReaperMain(void*) {
+    for (;;) {
+        svcSleepThread(100'000'000);
+        std::vector<struct __pthread_t*> done;
+        mutexLock(&g_detachLock);
+        auto& list = *g_detached;
+        for (size_t i = 0; i < list.size();) {
+            Thread* t = reinterpret_cast<Thread*>(list[i]);
+            if (R_SUCCEEDED(svcWaitSynchronizationSingle(t->handle, 0))) {
+                done.push_back(list[i]);
+                list[i] = list.back();
+                list.pop_back();
+            } else {
+                ++i;
+            }
+        }
+        mutexUnlock(&g_detachLock);
+        for (auto* t : done) __syscall_thread_join(t);
+    }
+    return nullptr;
+}
+}  // namespace
+extern "C" int __syscall_thread_detach(struct __pthread_t* thread) {
+    mutexLock(&g_detachLock);
+    if (!g_detached) g_detached = new std::vector<struct __pthread_t*>();
+    g_detached->push_back(thread);
+    const bool start = !g_reaperStarted;
+    g_reaperStarted = true;
+    mutexUnlock(&g_detachLock);
+    if (start) {
+        pthread_t reaper;
+        pthread_create(&reaper, nullptr, ReaperMain, nullptr);
+    }
+    return 0;
+}
+// The SD card's devoptab has no fchmod, so newlib returns ENOSYS. FAT keeps no Unix permissions,
+// so report success: otherwise std::filesystem::copy_file creates the file, fails on the
+// permission copy, and leaves it empty (the NAND bootstrap files were all 0 bytes).
+extern "C" int __real_fchmod(int fd, mode_t mode);
+extern "C" int __wrap_fchmod(int fd, mode_t mode) {
+    const int r = __real_fchmod(fd, mode);
+    if (r != 0 && errno == ENOSYS) {
+        errno = 0;
+        return 0;
+    }
+    return r;
+}
+// libnx creates every thread on the process's default core, which is also the game's core, so
+// audio mixing, shader compiles, the log flusher etc. all competed with the game. Move each new
+// thread onto core 2 (free to migrate to core 1). The game thread pins itself back to core 0 and
+// aurora's frame worker to core 1, which it keeps busy; its presenter pins itself to core 2.
+// (Alternating 1/2 left half the helpers, including SDL's audio thread, queued behind the worker:
+// the audio queue overflowed thousands of times per run.)
+extern "C" int __real_pthread_create(pthread_t* thread, const pthread_attr_t* attr,
+                                     void* (*start)(void*), void* arg);
+extern "C" int __wrap_pthread_create(pthread_t* thread, const pthread_attr_t* attr,
+                                     void* (*start)(void*), void* arg) {
+    // libnx's default thread stack is ~128 KB; Tint's shader compiler recurses far deeper (the
+    // frame worker overflowed compiling the seeded pipeline cache). Give every thread >= 4 MB.
+    constexpr size_t kMinStack = 4u << 20;
+    pthread_attr_t local;
+    size_t stack = 0;
+    if (attr == nullptr) {
+        pthread_attr_init(&local);
+        pthread_attr_setstacksize(&local, kMinStack);
+        attr = &local;
+    } else if (pthread_attr_getstacksize(attr, &stack) == 0 && stack < kMinStack) {
+        local = *attr;
+        pthread_attr_setstacksize(&local, kMinStack);
+        attr = &local;
+    }
+    const int r = __real_pthread_create(thread, attr, start, arg);
+    if (r == 0 && thread != nullptr && *thread != nullptr) {
+        Thread* t = reinterpret_cast<Thread*>(*thread);
+        svcSetThreadCoreMask(t->handle, 2, (1u << 1) | (1u << 2));
+    }
+    return r;
+}
