+// Several copies of the game at once (netplay tests run two to five on one Mac) must not share
+// the per-run caches:
+//  - nsmbw_data/Cache: the pipeline/shader sqlite databases ("database is locked" between copies)
+//    and the crash marker. A second copy found the first one's marker (armed while it runs), took
+//    it for a crash and deleted the databases the first copy had open.
+//  - Metal's own compiled-shader cache. Every unbundled Mac program shares one folder for it,
+//    $DARWIN_USER_CACHE_DIR/com.apple.metal, and with several copies compiling their boot
+//    pipelines at once one of them often crashed inside Apple's cache lookup (fscache_find_and_retain,
+//    SIGSEGV/SIGBUS in the first resolve_pass): 7 of 35 launches of five copies at once. 0 of 20
+//    with a Metal folder per copy, 0 of 20 with a Cache per copy, 0 of 20 with both (2026-11-18).
+// So each copy takes the first free instance slot, held by an flock that the OS drops when the
+// process ends (a crash included). Slot 0, the usual single copy, keeps nsmbw_data/Cache; slot n
+// uses nsmbw_data/Cache-n, which persists, so a test that starts n copies reuses n warm caches.
+// On the Mac a second slot, counted per user (Metal's folder is shared by every build), picks
+// Metal's cache folder: $DARWIN_USER_CACHE_DIR/NSMBWCompiled-n/com.apple.metal. Windows and the
+// Switch keep one shared Cache as before.
+#if !defined(_WIN32) && !defined(__SWITCH__)
+#define NSMBW_INSTANCE_SLOTS 1
+// First free slot n whose lock file <dir>/<prefix>n.lock can be locked; the descriptor stays open
+// (and locked) for the life of the process. -1 if all 16 are taken or the folder is unusable.
+int ClaimInstanceSlot(const std::filesystem::path& dir, const char* prefix) {
+    std::error_code ec;
+    std::filesystem::create_directories(dir, ec);
+    for (int slot = 0; slot < 16; ++slot) {
+        const auto path = dir / (std::string(prefix) + std::to_string(slot) + ".lock");
+        const int fd = ::open(path.c_str(), O_RDWR | O_CREAT | O_CLOEXEC, 0644);
+        if (fd < 0) return -1;
+        if (::flock(fd, LOCK_EX | LOCK_NB) == 0) return slot;
+        ::close(fd);
+    }
+    return -1;
+}
+#endif
