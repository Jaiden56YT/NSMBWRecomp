diff --git a/runtime/src/thread_cache_new.h b/runtime/src/thread_cache_new.h
new file mode 100644
index 0000000..cacdc76
--- /dev/null
+++ b/runtime/src/thread_cache_new.h
@@ -0,0 +1,274 @@
+// Thread-caching replacement for the global operator new/delete (Switch build; a stress test on
+// the Mac includes this header directly).
+//
+// newlib's malloc has one global lock. On the Switch the game thread and aurora's frame worker
+// (Dawn command recording) allocate constantly from different cores, and the game thread spent
+// ~19% of its time waiting for that lock (svcArbitrateLock under _malloc_r/_free_r). Small C++
+// allocations now come from per-thread free lists:
+//   - sizes up to kMaxSmall round up to a 16-byte class; every block has a 16-byte header that
+//     records its class (or kLargeClass for a plain malloc'd block),
+//   - a thread allocates from and frees into its own lists without locking; a block freed by a
+//     different thread than the one that allocated it simply joins the freeing thread's list,
+//   - lists exchange blocks with a per-class global pool in batches of kBatch (one lock per batch),
+//     and fresh blocks are carved from 64 KB malloc'd slabs, so malloc's lock is taken rarely.
+// Slabs are never returned to malloc. Memory from operator new is only ever released through
+// operator delete (the C++ rule), so the header is always present.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <mutex>
+#include <new>
+#include <pthread.h>
+
+namespace thread_cache_new {
+
+constexpr size_t kHeader = 16;
+constexpr size_t kGranule = 16;
+constexpr size_t kMaxSmall = 512;
+constexpr uint32_t kClasses = kMaxSmall / kGranule;  // class c holds (c + 1) * 16 bytes
+constexpr uint32_t kLargeClass = 0xFFFFFFFFu;
+constexpr uint32_t kMagic = 0x7C0FFEE1u;
+constexpr uint32_t kBatch = 32;
+constexpr uint32_t kLocalLimit = 2 * kBatch;
+constexpr size_t kSlabBytes = 64 * 1024;
+
+struct Header {
+    uint32_t sizeClass;
+    uint32_t magic;
+    uint64_t pad;
+};
+static_assert(sizeof(Header) == kHeader, "header must keep 16-byte alignment");
+
+struct FreeBlock {
+    FreeBlock* next;
+};
+
+struct GlobalPool {
+    std::mutex mutex;
+    FreeBlock* head = nullptr;
+    uint32_t count = 0;
+};
+
+inline GlobalPool* GlobalPools() {
+    // Built in static storage and never destroyed: frees can still arrive during process exit,
+    // after static destructors would have destroyed the mutexes.
+    alignas(GlobalPool) static unsigned char storage[sizeof(GlobalPool) * kClasses];
+    static GlobalPool* const pools = [] {
+        auto* first = reinterpret_cast<GlobalPool*>(storage);
+        for (uint32_t c = 0; c < kClasses; ++c) new (first + c) GlobalPool();
+        return first;
+    }();
+    return pools;
+}
+
+inline size_t BlockBytes(uint32_t c) { return kHeader + (static_cast<size_t>(c) + 1) * kGranule; }
+
+// Each thread's lists live in a malloc'd LocalCache (not in thread_local storage, which macOS can
+// release before pthread key destructors run); thread_local holds only a pointer. Trivial on
+// purpose: a thread_local with a destructor is registered through libstdc++'s __cxa_thread_atexit,
+// which itself calls operator new. Thread-exit cleanup goes through a pthread key destructor.
+struct LocalCache {
+    FreeBlock* head[kClasses];
+    uint32_t count[kClasses];
+};
+// nullptr = not set up yet; kGone = this thread's lists were returned at thread exit.
+inline LocalCache* const kGone = reinterpret_cast<LocalCache*>(uintptr_t{1});
+inline thread_local LocalCache* t_cache = nullptr;
+
+inline void PushGlobal(uint32_t c, FreeBlock* first, FreeBlock* last, uint32_t n) {
+    GlobalPool& pool = GlobalPools()[c];
+    std::lock_guard<std::mutex> lock(pool.mutex);
+    last->next = pool.head;
+    pool.head = first;
+    pool.count += n;
+}
+
+inline void FlushOnThreadExit(void* p) {
+    auto* lc = static_cast<LocalCache*>(p);
+    for (uint32_t c = 0; c < kClasses; ++c) {
+        if (lc->head[c] == nullptr) continue;
+        FreeBlock* last = lc->head[c];
+        while (last->next != nullptr) last = last->next;
+        PushGlobal(c, lc->head[c], last, lc->count[c]);
+    }
+    std::free(lc);
+    t_cache = kGone;
+}
+
+inline pthread_key_t& ExitKey() {
+    static pthread_key_t key;
+    return key;
+}
+inline void CreateExitKey() { pthread_key_create(&ExitKey(), FlushOnThreadExit); }
+
+// This thread's cache, or nullptr when it can't have one (thread exiting, or out of memory).
+inline LocalCache* Local() {
+    LocalCache* lc = t_cache;
+    if (lc != nullptr && lc != kGone) [[likely]] return lc;
+    if (lc == kGone) return nullptr;
+    lc = static_cast<LocalCache*>(std::calloc(1, sizeof(LocalCache)));
+    if (lc == nullptr) return nullptr;
+    t_cache = lc;
+    static pthread_once_t once = PTHREAD_ONCE_INIT;
+    pthread_once(&once, CreateExitKey);
+    pthread_setspecific(ExitKey(), lc);
+    return lc;
+}
+
+// Refill a thread's list for class c: a batch from the global pool, else a fresh slab.
+inline bool Refill(LocalCache& lc, uint32_t c) {
+    {
+        GlobalPool& pool = GlobalPools()[c];
+        std::lock_guard<std::mutex> lock(pool.mutex);
+        if (pool.head != nullptr) {
+            FreeBlock* first = pool.head;
+            FreeBlock* last = first;
+            uint32_t n = 1;
+            while (n < kBatch && last->next != nullptr) {
+                last = last->next;
+                ++n;
+            }
+            pool.head = last->next;
+            pool.count -= n;
+            last->next = lc.head[c];
+            lc.head[c] = first;
+            lc.count[c] += n;
+            return true;
+        }
+    }
+    const size_t blockBytes = BlockBytes(c);
+    const size_t blocks = kSlabBytes / blockBytes;
+    auto* slab = static_cast<unsigned char*>(std::malloc(blocks * blockBytes));
+    if (slab == nullptr) return false;
+    for (size_t i = 0; i < blocks; ++i) {
+        auto* block = reinterpret_cast<FreeBlock*>(slab + i * blockBytes);
+        block->next = lc.head[c];
+        lc.head[c] = block;
+    }
+    lc.count[c] += static_cast<uint32_t>(blocks);
+    return true;
+}
+
+// Off until Enable() (called at the start of main): allocations during static initialization take
+// the plain malloc path, so nothing depends on thread/TLS setup that may not exist yet.
+inline bool& EnabledFlag() {
+    static bool enabled = false;
+    return enabled;
+}
+inline void Enable() { EnabledFlag() = true; }
+
+inline void* Allocate(size_t size) {
+    if (size == 0) size = 1;
+    if (size <= kMaxSmall && EnabledFlag()) {
+        const uint32_t c = static_cast<uint32_t>((size - 1) / kGranule);
+        FreeBlock* block = nullptr;
+        if (LocalCache* lcp = Local()) {
+            LocalCache& lc = *lcp;
+            if (lc.head[c] == nullptr && !Refill(lc, c)) return nullptr;
+            block = lc.head[c];
+            lc.head[c] = block->next;
+            --lc.count[c];
+        } else {
+            // Thread is exiting: take one block straight from the pool or malloc.
+            GlobalPool& pool = GlobalPools()[c];
+            {
+                std::lock_guard<std::mutex> lock(pool.mutex);
+                if (pool.head != nullptr) {
+                    block = pool.head;
+                    pool.head = block->next;
+                    --pool.count;
+                }
+            }
+            if (block == nullptr) {
+                block = static_cast<FreeBlock*>(std::malloc(BlockBytes(c)));
+                if (block == nullptr) return nullptr;
+            }
+        }
+        auto* header = reinterpret_cast<Header*>(block);
+        header->sizeClass = c;
+        header->magic = kMagic;
+        return reinterpret_cast<unsigned char*>(header) + kHeader;
+    }
+    if (size > SIZE_MAX - kHeader) return nullptr;
+    auto* header = static_cast<Header*>(std::malloc(kHeader + size));
+    if (header == nullptr) return nullptr;
+    header->sizeClass = kLargeClass;
+    header->magic = kMagic;
+    return reinterpret_cast<unsigned char*>(header) + kHeader;
+}
+
+inline void Free(void* p) {
+    if (p == nullptr) return;
+    auto* header = reinterpret_cast<Header*>(static_cast<unsigned char*>(p) - kHeader);
+    if (header->magic != kMagic) {
+        // Not from operator new: a malloc'd block passed to delete. Plain newlib tolerated that,
+        // so keep tolerating it.
+        std::free(p);
+        return;
+    }
+    const uint32_t c = header->sizeClass;
+    if (c == kLargeClass) {
+        header->magic = 0;
+        std::free(header);
+        return;
+    }
+    if (c >= kClasses) std::abort();
+    header->magic = 0;
+    auto* block = reinterpret_cast<FreeBlock*>(header);
+    LocalCache* lcp = Local();
+    if (lcp == nullptr) {
+        PushGlobal(c, block, block, 1);
+        return;
+    }
+    LocalCache& lc = *lcp;
+    block->next = lc.head[c];
+    lc.head[c] = block;
+    if (++lc.count[c] > kLocalLimit) {
+        // Hand a batch back so a thread that mostly frees (the render worker releasing the game
+        // thread's allocations) doesn't hoard blocks.
+        FreeBlock* first = lc.head[c];
+        FreeBlock* last = first;
+        for (uint32_t i = 1; i < kBatch; ++i) last = last->next;
+        lc.head[c] = last->next;
+        lc.count[c] -= kBatch;
+        PushGlobal(c, first, last, kBatch);
+    }
+}
+
+inline void* AllocateOrThrow(size_t size) {
+    for (;;) {
+        if (void* p = Allocate(size)) return p;
+        std::new_handler handler = std::get_new_handler();
+        if (handler == nullptr) throw std::bad_alloc();
+        handler();
+    }
+}
+
+// True when p carries this allocator's header (used by the free() wrapper on the Switch so C code
+// that frees an operator-new block with free() returns it here instead of corrupting malloc).
+inline bool Owns(const void* p) {
+    if (p == nullptr || (reinterpret_cast<uintptr_t>(p) & 15u) != 0) return false;
+    const auto* header = reinterpret_cast<const Header*>(static_cast<const unsigned char*>(p) - kHeader);
+    return header->magic == kMagic;
+}
+
+}  // namespace thread_cache_new
+
+// Defines the replaceable global operators; include in exactly one translation unit.
+#define THREAD_CACHE_NEW_DEFINE_OPERATORS                                                              \
+    void* operator new(std::size_t size) { return thread_cache_new::AllocateOrThrow(size); }          \
+    void* operator new[](std::size_t size) { return thread_cache_new::AllocateOrThrow(size); }        \
+    void* operator new(std::size_t size, const std::nothrow_t&) noexcept {                            \
+        return thread_cache_new::Allocate(size);                                                      \
+    }                                                                                                 \
+    void* operator new[](std::size_t size, const std::nothrow_t&) noexcept {                          \
+        return thread_cache_new::Allocate(size);                                                      \
+    }                                                                                                 \
+    void operator delete(void* p) noexcept { thread_cache_new::Free(p); }                             \
+    void operator delete[](void* p) noexcept { thread_cache_new::Free(p); }                           \
+    void operator delete(void* p, std::size_t) noexcept { thread_cache_new::Free(p); }                \
+    void operator delete[](void* p, std::size_t) noexcept { thread_cache_new::Free(p); }              \
+    void operator delete(void* p, const std::nothrow_t&) noexcept { thread_cache_new::Free(p); }      \
+    void operator delete[](void* p, const std::nothrow_t&) noexcept { thread_cache_new::Free(p); }
