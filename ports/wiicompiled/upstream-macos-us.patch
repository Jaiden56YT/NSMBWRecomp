+    uint32_t unsupported = 0;       // ocarina, unmapped addresses, failed searches
+};
+
+// Applies every active overlay's <memory> patches to guest RAM, lowest
+// priority first (so a higher-priority mod wins on overlap). Data patches are
+// written; code patches are only reported. Safe to call more than once: only
+// the first call does anything.
+const MemoryPatchReport& ApplyMemoryPatches();
+
+// Code mods built by tools/mod_build.py: a Kamek module linked ahead of time at a fixed guest
+// address (translated with the game), and the loader's data patches, which must be written when
+// the game calls the loader (after the RELs' static constructors), not at boot. The generated mod
+// source registers both from a static constructor.
+struct ModImage {
+    uint32_t base = 0;
+    const uint8_t* data = nullptr;
+    uint32_t size = 0;
+    std::string name;
+};
+void RegisterModImage(uint32_t base, const uint8_t* data, uint32_t size, const char* name);
+void RegisterModPatch(uint32_t address, const uint8_t* data, uint32_t size);
+// A Kamek module's static constructor (Kamek 2 binaries list them; the loader calls them after
+// linking). The product's native loader calls them, in registration order.
+void RegisterModCtor(uint32_t address);
+const std::vector<uint32_t>& ModCtors();
+const std::vector<ModImage>& ModImages();
+// Lowest base of any registered image (0 if none): the product keeps the MEM1 arena below it.
+uint32_t ModImagesLowestBase();
+// Copies the images into guest RAM. Call once the OS has finished clearing the arena (the images
+// sit at its top) and before the game creates its heaps.
+void InstallModImages();
+// Writes the registered loader patches; called by the product's native Kamek loader. Returns the
+// number of patches written.
+uint32_t ApplyModLoaderPatches();
+
 } // namespace RuntimeRiivolution
diff --git a/runtime/src/hle/storage/riivolution_memory.cpp b/runtime/src/hle/storage/riivolution_memory.cpp
new file mode 100644
index 0000000..5d00daa
--- /dev/null
+++ b/runtime/src/hle/storage/riivolution_memory.cpp
@@ -0,0 +1,328 @@
+// Riivolution <memory> patches for a statically translated game.
+//
+// Riivolution writes its memory patches into RAM after the main executable is
+// loaded and before it runs. Here the executable's code was translated ahead of
+// time, so only patches to *data* can take effect by writing guest RAM. Patches
+// that land in a registered code range are reported instead: they need the code
+// re-translated with the patch applied (tools/mod_build.py, see docs/mods.md).
+//
+// Matching follows Dolphin's RiivolutionPatcher: a patch with `original` is
+// applied only where memory holds those bytes (that is how one XML carries
+// patches for several regions), and `search` patches find `original` in MEM1
+// (stride `align`) and patch the first match.
+//
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "hle/storage/riivolution.h"
+
+#include "memory.h"
+#include "runtime_config.h"
+#include "runtime_log.h"
+
+#include <cstring>
+#include <iomanip>
+#include <mutex>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct CodeRange {
+    uint32_t start;
+    uint32_t end;
+    std::string name;
+};
+
+std::vector<CodeRange>& CodeRanges() {
+    static std::vector<CodeRange> ranges;
+    return ranges;
+}
+
+const CodeRange* FindCodeRange(uint32_t address, size_t length) {
+    const uint64_t end = static_cast<uint64_t>(address) + length;
+    for (const CodeRange& range : CodeRanges()) {
+        if (address < range.end && end > range.start) {
+            return &range;
+        }
+    }
+    return nullptr;
+}
+
+std::string Hex(uint32_t value) {
+    std::ostringstream text;
+    text << "0x" << std::hex << std::uppercase << std::setw(8) << std::setfill('0') << value;
+    return text.str();
+}
+
+bool MemoryEquals(uint32_t address, const std::vector<uint8_t>& bytes) {
+    if (bytes.empty() || !Memory::Contains(address, static_cast<uint32_t>(bytes.size()))) {
+        return false;
+    }
+    const void* pointer = Memory::GetPointer(address, static_cast<uint32_t>(bytes.size()));
+    return pointer && std::memcmp(pointer, bytes.data(), bytes.size()) == 0;
+}
+
+// MEM1 as the game sees it (24 MiB); MEM2 is heap the game fills at runtime.
+constexpr uint32_t kSearchStart = 0x80000000u;
+constexpr uint32_t kSearchEnd = 0x81800000u;
+
+std::optional<uint32_t> SearchMemory(const std::vector<uint8_t>& pattern, uint32_t start, uint32_t align) {
+    if (pattern.empty()) {
+        return std::nullopt;
+    }
+    const uint32_t stride = align == 0 ? 1u : align;
+    uint32_t first = start >= kSearchStart && start < kSearchEnd ? start : kSearchStart;
+    first -= (first - kSearchStart) % stride;
+    for (uint32_t address = first; address + pattern.size() <= kSearchEnd; address += stride) {
+        if (MemoryEquals(address, pattern)) {
+            return address;
+        }
+    }
+    return std::nullopt;
+}
+
+constexpr uint32_t kMaxDetailLines = 24;
+
+RuntimeRiivolution::MemoryPatchReport g_report;
+std::once_flag g_applyOnce;
+
+struct BlobRange {
+    uint32_t start;
+    uint32_t end;
+};
+
+// Words of a data patch that point into a blob a valuefile patch loads outside the translated
+// ranges. Such a blob is almost always code (Newer's Loader.bin at 0x80001800, a Kamek -static
+// binary), and the pointer would make the game call it: there is nothing translated there, so
+// the runtime stops with missing_target. Returns the first such word.
+std::optional<uint32_t> PointerIntoBlob(const RuntimeRiivolution::MemoryPatch& patch,
+                                        const std::vector<BlobRange>& blobs) {
+    if (blobs.empty() || !patch.valuefileName.empty() || patch.value.size() < 4 || (patch.offset & 3u) != 0) {
+        return std::nullopt;
+    }
+    for (size_t i = 0; i + 4 <= patch.value.size(); i += 4) {
+        const uint32_t word = (uint32_t(patch.value[i]) << 24) | (uint32_t(patch.value[i + 1]) << 16) |
+                              (uint32_t(patch.value[i + 2]) << 8) | uint32_t(patch.value[i + 3]);
+        for (const BlobRange& blob : blobs) {
+            if (word >= blob.start && word < blob.end) {
+                return word;
+            }
+        }
+    }
+    return std::nullopt;
+}
+
+void ApplyOne(const RuntimeRiivolution::MemoryPatch& patch, const std::string& modLabel,
+              const std::vector<BlobRange>& blobs, RuntimeRiivolution::MemoryPatchReport& report,
+              uint32_t& codeLines) {
+    if (patch.ocarina) {
+        ++report.unsupported;
+        RT_LOG(RT_TAG_RIIVOLUTION) << modLabel << ": " << patch.source
+                  << ": ocarina memory patches are not supported, skipped" << std::endl;
+        return;
+    }
+
+    uint32_t address = patch.offset;
+    if (patch.search) {
+        const auto found = SearchMemory(patch.original, patch.offset, patch.align);
+        if (!found) {
+            ++report.unsupported;
+            RT_LOG(RT_TAG_RIIVOLUTION) << modLabel << ": " << patch.source
+                      << ": search patch found no match, skipped" << std::endl;
+            return;
+        }
+        address = *found;
+    }
+
+    const uint32_t length = static_cast<uint32_t>(patch.value.size());
+    if (!Memory::Contains(address, length)) {
+        ++report.unsupported;
+        RT_LOG(RT_TAG_RIIVOLUTION) << modLabel << ": " << patch.source << ": " << Hex(address)
+                  << " (+" << length << ") is outside guest memory, skipped" << std::endl;
+        return;
+    }
+
+    if (MemoryEquals(address, patch.value)) {
+        ++report.alreadyApplied;
+        return;
+    }
+    if (!patch.search && !patch.original.empty() && !MemoryEquals(address, patch.original)) {
+        // Normal for multi-region XMLs: the patch is for another region/version.
+        ++report.originalMismatch;
+        return;
+    }
+
+    if (const CodeRange* range = FindCodeRange(address, length)) {
+        ++report.codeNeedsModBuild;
+        if (codeLines++ < kMaxDetailLines) {
+            // In a mod build the code patches are already in the translation; what is left here is
+            // what the build deliberately replaced (e.g. a Kamek loader and its hook).
+            const bool modBuild = !RuntimeRiivolution::ModImages().empty();
+            RT_LOG(RT_TAG_RIIVOLUTION) << modLabel << ": " << patch.source << ": code patch at "
+                      << Hex(address) << " (" << length << " bytes, " << range->name << ") "
+                      << (modBuild ? "not applied (this mod build replaces it)"
+                                   : "needs a mod build (tools/mod_build.py); not applied")
+                      << std::endl;
+        }
+        return;
+    }
+
+    if (const auto target = PointerIntoBlob(patch, blobs)) {
+        ++report.codeNeedsModBuild;
+        RT_LOG(RT_TAG_RIIVOLUTION) << modLabel << ": " << patch.source << ": data patch at " << Hex(address)
+                  << " points the game at " << Hex(*target)
+                  << ", inside code loaded by a valuefile patch; that code is not translated, so this "
+                  << "patch is skipped (the mod's code needs a mod build)" << std::endl;
+        return;
+    }
+
+    void* pointer = Memory::GetPointer(address, length);
+    if (!pointer) {
+        ++report.unsupported;
+        return;
+    }
+    std::memcpy(pointer, patch.value.data(), length);
+    ++report.applied;
+    // Low memory below the OS globals is where Riivolution loaders put code
+    // (e.g. Newer's Loader.bin at 0x80001800). Nothing translated lives there.
+    if (address >= 0x80001800u && address < 0x80003000u && length > 64) {
+        RT_LOG(RT_TAG_RIIVOLUTION) << modLabel << ": " << patch.source << ": wrote " << length
+                  << " bytes at " << Hex(address)
+                  << " (low memory); if this is loader code it only runs in a mod build" << std::endl;
+    }
+}
+
+void ApplyAll() {
+    const auto& overlays = RuntimeRiivolution::Overlays();
+    // Lowest priority first, so a higher-priority pack's bytes end up in RAM.
+    for (auto overlay = overlays.rbegin(); overlay != overlays.rend(); ++overlay) {
+        if (!overlay->patches || overlay->patches->memoryPatches.empty()) {
+            continue;
+        }
+        const std::string label =
+            overlay->modName.empty() ? RuntimeConfigFile::PathToUtf8(overlay->root) : "mod '" + overlay->modName + "'";
+        std::vector<BlobRange> blobs;
+        for (const auto& patch : overlay->patches->memoryPatches) {
+            const uint32_t length = static_cast<uint32_t>(patch.value.size());
+            if (!patch.valuefileName.empty() && !patch.search && !FindCodeRange(patch.offset, length)) {
+                blobs.push_back({patch.offset, patch.offset + length});
+            }
+        }
+        RuntimeRiivolution::MemoryPatchReport local;
+        uint32_t codeLines = 0;
+        for (const auto& patch : overlay->patches->memoryPatches) {
+            ApplyOne(patch, label, blobs, local, codeLines);
+        }
+        if (codeLines > kMaxDetailLines) {
+            RT_LOG(RT_TAG_RIIVOLUTION) << label << ": ... " << (codeLines - kMaxDetailLines)
+                      << " more code patch(es)" << std::endl;
+        }
+        RT_LOG(RT_TAG_RIIVOLUTION) << label << ": memory patches: " << local.applied << " applied, "
+                  << local.alreadyApplied << " already in place, " << local.originalMismatch
+                  << " for another region/version, " << local.codeNeedsModBuild
+                  << " code patch(es) needing a mod build, " << local.unsupported << " unsupported"
+                  << std::endl;
+        g_report.applied += local.applied;
+        g_report.alreadyApplied += local.alreadyApplied;
+        g_report.originalMismatch += local.originalMismatch;
+        g_report.codeNeedsModBuild += local.codeNeedsModBuild;
+        g_report.unsupported += local.unsupported;
+    }
+}
+
+} // namespace
+
+namespace {
+
+struct ModPatch {
+    uint32_t address;
+    const uint8_t* data;
+    uint32_t size;
+};
+
+std::vector<RuntimeRiivolution::ModImage>& ModImageList() {
+    static std::vector<RuntimeRiivolution::ModImage> images;
+    return images;
+}
+
+std::vector<ModPatch>& ModPatchList() {
+    static std::vector<ModPatch> patches;
+    return patches;
+}
+
+std::vector<uint32_t>& ModCtorList() {
+    static std::vector<uint32_t> ctors;
+    return ctors;
+}
+
+} // namespace
+
+namespace RuntimeRiivolution {
+
+void RegisterModImage(uint32_t base, const uint8_t* data, uint32_t size, const char* name) {
+    ModImageList().push_back({base, data, size, name ? name : "mod"});
+    RegisterCodeRange(base, base + size, name);
+}
+
+void RegisterModPatch(uint32_t address, const uint8_t* data, uint32_t size) {
+    ModPatchList().push_back({address, data, size});
+}
+
+const std::vector<ModImage>& ModImages() { return ModImageList(); }
+
+void RegisterModCtor(uint32_t address) { ModCtorList().push_back(address); }
+
+const std::vector<uint32_t>& ModCtors() { return ModCtorList(); }
+
+uint32_t ModImagesLowestBase() {
+    uint32_t lowest = 0;
+    for (const ModImage& image : ModImageList()) {
+        if (lowest == 0 || image.base < lowest) {
+            lowest = image.base;
+        }
+    }
+    return lowest;
+}
+
+void InstallModImages() {
+    for (const ModImage& image : ModImageList()) {
+        void* pointer = Memory::Contains(image.base, image.size) ? Memory::GetPointer(image.base, image.size) : nullptr;
+        if (!pointer) {
+            RT_LOG(RT_TAG_RIIVOLUTION) << "ERROR: mod image " << image.name << " at " << Hex(image.base)
+                      << " is outside guest memory" << std::endl;
+            continue;
+        }
+        std::memcpy(pointer, image.data, image.size);
+        RT_LOG(RT_TAG_RIIVOLUTION) << "mod code " << image.name << ": " << image.size << " bytes at "
+                  << Hex(image.base) << " (translated ahead of time)" << std::endl;
+    }
+}
+
+uint32_t ApplyModLoaderPatches() {
+    uint32_t written = 0;
+    for (const ModPatch& patch : ModPatchList()) {
+        if (void* pointer = Memory::Contains(patch.address, patch.size) ? Memory::GetPointer(patch.address, patch.size) : nullptr) {
+            std::memcpy(pointer, patch.data, patch.size);
+            ++written;
+        } else {
+            RT_LOG(RT_TAG_RIIVOLUTION) << "WARNING: loader patch at " << Hex(patch.address)
+                      << " is outside guest memory" << std::endl;
+        }
+    }
+    return written;
+}
+
+void RegisterCodeRange(uint32_t start, uint32_t end, const char* name) {
+    if (end > start) {
+        CodeRanges().push_back({start, end, name ? name : "code"});
+    }
+}
+
+const MemoryPatchReport& ApplyMemoryPatches() {
+    std::call_once(g_applyOnce, ApplyAll);
+    return g_report;
+}
+
+} // namespace RuntimeRiivolution
