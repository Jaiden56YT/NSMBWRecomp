+#pragma once
+// x86 SIMD on every host: the real intrinsics on x86-64, SIMDe (SIMD Everywhere,
+// MIT) with native aliases elsewhere, so the SSE/AVX2/FMA code in the ISA headers
+// and audio kernels compiles unchanged for ARM64 (macOS, Switch).
+//
+// MXCSR is the one thing that is not plain arithmetic. The runtime only uses its
+// FTZ|DAZ bits (guest FPSCR[NI]) and saves/restores the whole register, so on ARM
+// MkwHostGetCsr/MkwHostSetCsr map those bits onto FPCR.FZ (bit 24, which flushes
+// both inputs and outputs like FTZ+DAZ) and keep the rest as a shadow value.
+#include <cstdint>
+
+#if defined(__x86_64__) || defined(_M_X64) || defined(__i386__)
+#include <immintrin.h>
+inline uint32_t MkwHostGetCsr() noexcept { return _mm_getcsr(); }
+inline void MkwHostSetCsr(uint32_t v) noexcept { _mm_setcsr(v); }
+#else
+#define SIMDE_ENABLE_NATIVE_ALIASES
+#include <simde/x86/avx2.h>
+#include <simde/x86/fma.h>
+#include <simde/x86/sse4.2.h>
+#if defined(__aarch64__)
+inline uint64_t MkwReadFpcr() noexcept { uint64_t v; __asm__ volatile("mrs %0, fpcr" : "=r"(v)); return v; }
+inline void MkwWriteFpcr(uint64_t v) noexcept { __asm__ volatile("msr fpcr, %0" : : "r"(v)); }
+#else
+inline uint64_t MkwReadFpcr() noexcept { return 0; }
+inline void MkwWriteFpcr(uint64_t) noexcept {}
+#endif
+inline thread_local uint32_t g_mkwShadowCsr = 0x1F80u;  // x86 power-on MXCSR: all exceptions masked
+inline uint32_t MkwHostGetCsr() noexcept
+{
+    const bool fz = (MkwReadFpcr() >> 24) & 1u;
+    const uint32_t ftzDaz = (1u << 15) | (1u << 6);
+    return fz ? (g_mkwShadowCsr | ftzDaz) : (g_mkwShadowCsr & ~ftzDaz);
+}
+inline void MkwHostSetCsr(uint32_t v) noexcept
+{
+    g_mkwShadowCsr = v;
+    const uint64_t fpcr = MkwReadFpcr();
+    const uint64_t want = (v & (1u << 15)) ? (fpcr | (1ull << 24)) : (fpcr & ~(1ull << 24));
