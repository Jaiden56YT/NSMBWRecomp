+bool ReadableWord(uint64_t addr) {
+    MemoryInfo mi{};
+    u32 pageInfo = 0;
+    return (addr & 7u) == 0 && addr != 0 && R_SUCCEEDED(svcQueryMemory(&mi, &pageInfo, addr)) &&
+           (mi.perm & Perm_R) != 0 && addr + 16 <= mi.addr + mi.size;
+}
+void* ProfilerMain(void*) {
+    svcSetThreadCoreMask(CUR_THREAD_HANDLE, 2, 1u << 2);
+    // Above aurora's presenter (also on core 2, raised to SDL's HIGH priority): if the presenter
+    // preempts this thread while it holds a thread paused, that thread stays frozen. Run 23 showed
+    // 2 s game frames and a 44 s profile window with no samples. It sleeps 1 ms per sample anyway.
+    svcSetThreadPriority(CUR_THREAD_HANDLE, 0x20);
+    using Key = std::array<uint64_t, 18>;  // pc, lr, then sixteen frame-chain return addresses
+    std::map<Key, uint32_t> counts[2];
+    uint64_t totals[2] = {0, 0};
+    const uint64_t start = armGetSystemTick();
+    uint64_t lastDump = start;
+    const uint64_t dumpTicks = armNsToTicks(30'000'000'000ull);
+    uint32_t window = 0;
+    for (uint32_t n = 0;; ++n) {
+        svcSleepThread(1'000'000);  // 1 ms; two threads -> ~500 Hz each
+        const int slot = static_cast<int>(n & 1u);
+        const Handle h = g_profThreads[slot].load(std::memory_order_relaxed);
+        if (h != INVALID_HANDLE) {
+            ThreadContext ctx;
+            Key key{};
+            bool ok = false;
+            if (R_SUCCEEDED(svcSetThreadActivity(h, ThreadActivity_Paused))) {
+                for (int tries = 0; tries < 4 && !ok; ++tries) {
+                    ok = R_SUCCEEDED(svcGetThreadContext3(&ctx, h));
+                    if (!ok) svcSleepThread(20'000);
+                }
+                if (ok) {
+                    key[0] = ctx.pc.x;
+                    key[1] = ctx.lr;
+                    uint64_t fp = ctx.fp;
