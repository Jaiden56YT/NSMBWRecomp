+// Startup check of SQLite file I/O on the SD card (the shader caches failed with "database disk
+// image is malformed"): runs the same steps as the caches with the default and the Switch
+// settings, and logs each step's result to stderr.
+static void SwitchSqliteSelfTest() {
+    struct Variant { const char* name; const char* pragmas; };
+    const Variant variants[] = {
+        {"default", ""},
+        {"switch", "PRAGMA locking_mode=EXCLUSIVE; PRAGMA journal_mode=MEMORY; PRAGMA synchronous=OFF;"},
+    };
+    for (const auto& v : variants) {
+        const std::string path = std::string("/switch/nsmbw2/sqlite_selftest_") + v.name + ".db";
+        std::remove(path.c_str());
+        std::remove((path + "-journal").c_str());
+        const char* steps[] = {
+            v.pragmas,
+            "CREATE TABLE t(k INTEGER PRIMARY KEY, v BLOB);",
+            "INSERT INTO t(v) VALUES (zeroblob(5000)), (zeroblob(9000)), (randomblob(3000));",
+            "SELECT count(*), sum(length(v)) FROM t;",
+        };
+        sqlite3* db = nullptr;
+        int rc = sqlite3_open(path.c_str(), &db);
+        std::fprintf(stderr, "[sqlite-test] %s open rc=%d %s\n", v.name, rc, db ? sqlite3_errmsg(db) : "");
+        for (const char* sql : steps) {
+            if (rc != 0 || sql[0] == '\0') continue;
+            std::string result;
+            char* err = nullptr;
+            rc = sqlite3_exec(db, sql, [](void* out, int n, char** vals, char**) -> int {
+                    for (int i = 0; i < n; ++i) { *static_cast<std::string*>(out) += vals[i] ? vals[i] : "NULL"; *static_cast<std::string*>(out) += ' '; }
+                    return 0;
+                }, &result, &err);
+            std::fprintf(stderr, "[sqlite-test] %s rc=%d %s %s :: %.40s\n", v.name, rc, err ? err : "", result.c_str(), sql);
+        }
+        sqlite3_close(db);
+        db = nullptr;
+        // Reopen and read back what was written.
+        rc = sqlite3_open(path.c_str(), &db);
+        std::string result;
+        char* err = nullptr;
+        if (rc == 0) {
+            rc = sqlite3_exec(db, "SELECT count(*), sum(length(v)) FROM t;", [](void* out, int n, char** vals, char**) -> int {
+                    for (int i = 0; i < n; ++i) { *static_cast<std::string*>(out) += vals[i] ? vals[i] : "NULL"; *static_cast<std::string*>(out) += ' '; }
+                    return 0;
+                }, &result, &err);
+        }
+        struct stat st{};
+        stat(path.c_str(), &st);
+        std::fprintf(stderr, "[sqlite-test] %s reopen rc=%d %s %s size=%lld (expect 3 17000)\n", v.name, rc,
+                     err ? err : "", result.c_str(), static_cast<long long>(st.st_size));
+        sqlite3_close(db);
+    }
+}
