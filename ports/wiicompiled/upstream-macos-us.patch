+// Sampling profiler for hardware runs. A thread on core 2 pauses each registered thread about 500
+// times a second (game thread = slot 0, aurora frame worker = slot 1), reads its PC and LR and
+// walks sixteen frames of the frame-pointer chain, then resumes it. Every 30 s the window's counts
+// go to /switch/nsmbw2/profile_<n>.txt (n = window index mod 40) and are cleared, so startup and
+// gameplay land in different files. Addresses are absolute; "main=" gives the load base.
+#include <array>
+#include <malloc.h>
+#include <atomic>
+#include <cstdio>
+#include <map>
