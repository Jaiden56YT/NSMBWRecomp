+// this), so the game runs on a thread with a large stack; the log goes to the SD card.
+int main() {
+    SwitchThreadCacheEnable();
+    chdir("/switch/nsmbw2");
+    setenv("XDG_DATA_HOME", "/switch/nsmbw2", 1);
+    // The SD driver will not open one file twice, so stderr (aurora, Dawn) gets its own file.
+    // Logs are block-buffered and flushed every 250 ms by NsmbwMain (unbuffered writes to the SD
+    // card cost the game thread time); the terminate handler below flushes before aborting.
+    std::freopen("/switch/nsmbw2/nsmbw.log", "w", stdout);
+    std::freopen("/switch/nsmbw2/nsmbw_err.log", "w", stderr);
+    // Atmosphere writes crash reports outside the folder the test station can read, so copy any new
+    // ones next to the logs (crash_reports/<name>) for the station to fetch.
+    {
+        std::error_code ec;
+        const std::filesystem::path dst = "/switch/nsmbw2/crash_reports";
+        for (const char* src : {"/atmosphere/crash_reports", "/atmosphere/fatal_reports"}) {
+            for (const auto& entry : std::filesystem::directory_iterator(src, ec)) {
+                if (!entry.is_regular_file(ec)) continue;
+                std::filesystem::create_directories(dst, ec);
+                const auto target = dst / entry.path().filename();
+                if (std::filesystem::exists(target, ec)) continue;
+                std::filesystem::copy_file(entry.path(), target, ec);
+                std::fprintf(stderr, "[switch] copied crash report %s\n", entry.path().filename().c_str());
+            }
+        }
+    }
+    setenv("SDL_SWITCH_NO_EGL_SURFACE", "1", 1);
+    setenv("NSMBW_LOG_INTERP", "1", 0);  // frame timing / idle / shader-compile stats every 2 s
+    setenv("AURORA_LOG_WORKER_TIMING", "1", 0);  // frame worker phase timings every 120 frames
+    // Optional overrides without a rebuild: /switch/nsmbw2/env.txt, one NAME=value per line
+    // ('#' starts a comment), applied over the defaults above.
+    if (FILE* env = std::fopen("/switch/nsmbw2/env.txt", "r")) {
+        char line[512];
+        while (std::fgets(line, sizeof(line), env) != nullptr) {
+            std::string text(line);
+            while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' ')) text.pop_back();
+            if (text.empty() || text[0] == '#') continue;
+            const size_t eq = text.find('=');
