+// CPU clock. Games run the CPU at 1020 MHz; 1785 MHz is the Switch's own boost clock (what official
+// games get on loading screens, and the highest rate within Nintendo's specs). The game thread is
+// CPU-bound (world map ~35 fps at 1020 MHz), so request the boost clock for the whole session and
+// put the old rate back on exit. Docking or undocking can reapply the system's clock, so
+// SwitchCpuClockMaintain (every 2 s) re-requests it. NSMBW_CPU_MHZ in env.txt picks the rate
+// (0 = leave the clock alone); rates above 1785 are refused.
+static ClkrstSession g_cpuClockSession{};
+static bool g_cpuClockOpen = false;
+static u32 g_cpuClockOriginalHz = 0;
+static u32 g_cpuClockTargetHz = 0;
+static u32 g_cpuClockReapplied = 0;
+static void SwitchCpuClockRestore() {
+    if (!g_cpuClockOpen) return;
+    if (g_cpuClockOriginalHz != 0) clkrstSetClockRate(&g_cpuClockSession, g_cpuClockOriginalHz);
+    clkrstCloseSession(&g_cpuClockSession);
+    clkrstExit();
+    g_cpuClockOpen = false;
+}
+static void SwitchCpuClockBoost() {
+    const char* setting = std::getenv("NSMBW_CPU_MHZ");
+    const unsigned long mhz = setting != nullptr ? std::strtoul(setting, nullptr, 10) : 1785ul;
+    if (mhz == 0) {
+        std::fprintf(stderr, "[switch] CPU clock: left alone (NSMBW_CPU_MHZ=0)\n");
+        return;
+    }
+    if (mhz > 1785ul) {
+        std::fprintf(stderr, "[switch] CPU clock: %lu MHz refused (above the 1785 MHz boost clock)\n", mhz);
+        return;
+    }
+    if (hosversionBefore(8, 0, 0)) {
+        std::fprintf(stderr, "[switch] CPU clock: firmware too old for clkrst, left alone\n");
+        return;
+    }
+    Result rc = clkrstInitialize();
+    if (R_FAILED(rc)) {
+        std::fprintf(stderr, "[switch] CPU clock: clkrstInitialize failed 0x%x\n", rc);
+        return;
+    }
+    rc = clkrstOpenSession(&g_cpuClockSession, PcvModuleId_CpuBus, 3);
+    if (R_FAILED(rc)) {
+        std::fprintf(stderr, "[switch] CPU clock: clkrstOpenSession failed 0x%x\n", rc);
+        clkrstExit();
+        return;
+    }
+    g_cpuClockOpen = true;
+    clkrstGetClockRate(&g_cpuClockSession, &g_cpuClockOriginalHz);
+    g_cpuClockTargetHz = static_cast<u32>(mhz * 1000000ul);
+    rc = clkrstSetClockRate(&g_cpuClockSession, g_cpuClockTargetHz);
+    u32 nowHz = 0;
+    clkrstGetClockRate(&g_cpuClockSession, &nowHz);
+    std::fprintf(stderr, "[switch] CPU clock: %u -> %u MHz requested (rc 0x%x), now %u MHz\n",
+                 g_cpuClockOriginalHz / 1000000u, g_cpuClockTargetHz / 1000000u, rc, nowHz / 1000000u);
+    std::atexit(SwitchCpuClockRestore);
+}
+// Called from the 2 s stats block on the game thread.
+void SwitchCpuClockMaintain() {
+    if (!g_cpuClockOpen || g_cpuClockTargetHz == 0) return;
+    u32 nowHz = 0;
+    if (R_FAILED(clkrstGetClockRate(&g_cpuClockSession, &nowHz))) return;
+    if (nowHz != g_cpuClockTargetHz) {
+        clkrstSetClockRate(&g_cpuClockSession, g_cpuClockTargetHz);
+        if (++g_cpuClockReapplied <= 20) {
+            std::fprintf(stderr, "[switch] CPU clock was %u MHz, re-requested %u MHz\n", nowHz / 1000000u,
+                         g_cpuClockTargetHz / 1000000u);
+        }
+    }
+}
