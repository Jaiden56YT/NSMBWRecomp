-    message(FATAL_ERROR "WiiCompiled requires 64-bit Clang targeting x86_64")
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(AMD64|amd64|x86_64|X86_64)$")
+    set(MKW_HOST_ARCH_FLAGS -march=x86-64-v3)
+elseif(APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
+    set(MKW_HOST_ARCH_FLAGS -mcpu=apple-m1)
+else()
+    set(MKW_HOST_ARCH_FLAGS "")
 endif()
+set(MKW_SIMDE_DIR "${CMAKE_CURRENT_LIST_DIR}/../../simde" CACHE PATH "SIMDe checkout (x86 intrinsics on ARM)")
