+// Gives each picture / text pane in `panes` a copy of its material, named after the pane, with red
+// and blue swapped in its colour registers.
+void CloneMaterialsSwapped(Sectioned& l, const std::vector<std::string>& panes) {
+    const size_t matIndex = FindSection(l, "mat1");
+    std::vector<Bytes> entries = MaterialEntries(l.sections[matIndex]);
+    for (const std::string& name : panes) {
+        Bytes& pane = Pane(l, name);
+        const std::string m = Magic(pane);
+        const size_t field = m == "pic1" ? 0x5C : m == "txt1" ? 0x50 : 0;
+        Require(field != 0, "material clone of a pane without one");
+        const uint16_t index = Get16(pane, field);
+        Require(index < entries.size(), "material index out of range");
+        Bytes copy = entries[index];
+        PutName(copy, 0, 20, name);
+        for (size_t reg = 0; reg < 3; ++reg) { // s16 r, g, b, a per register
+            const size_t at = 20 + 8 * reg;
+            std::swap(copy[at], copy[at + 4]);
+            std::swap(copy[at + 1], copy[at + 5]);
+        }
+        Put16(pane, field, uint16_t(entries.size()));
+        entries.push_back(std::move(copy));
+    }
+    l.sections[matIndex] = WriteMaterials(l.sections[matIndex], entries);
+}
+
+void SetMaterialTexture(Sectioned& l, const std::string& material, uint16_t texture) {
+    Bytes& mat = l.sections[FindSection(l, "mat1")];
+    for (uint16_t i = 0, n = Get16(mat, 8); i < n; ++i) {
+        const uint32_t at = Get32(mat, 12 + 4 * i);
+        if (Name(mat, at, 20) != material) continue;
+        Require((Get32(mat, at + 60) & 0xF) >= 1, "material without a texture");
+        Put16(mat, at + 64, texture);
+        return;
+    }
+    throw Failure{"missing material " + material};
+}
