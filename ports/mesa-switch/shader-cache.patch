+++ b/src/gallium/drivers/nouveau/nouveau_screen.c
@@ -153,9 +153,18 @@ nouveau_disk_cache_create(struct nouveau_screen *screen)
    uint64_t driver_flags = 0;
 
    _mesa_sha1_init(&ctx);
+#ifdef __SWITCH__
+   /* No dladdr/build-id here: any rebuild of this library changes the id, so entries from a
+    * different compiler or Mesa change are never reused. */
+   {
+      static const char build_id[] = "switch-mesa " PACKAGE_VERSION " nouveau " __DATE__ " " __TIME__;
+      _mesa_sha1_update(&ctx, build_id, sizeof(build_id));
+   }
+#else
    if (!disk_cache_get_function_identifier(nouveau_disk_cache_create,
                                            &ctx))
       return;
+#endif
 
    _mesa_sha1_final(&ctx, sha1);
    disk_cache_format_hex_id(cache_id, sha1, 20 * 2);
