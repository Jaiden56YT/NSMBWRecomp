diff --git a/src/egl/drivers/switch/egl_switch.c b/src/egl/drivers/switch/egl_switch.c
index af56ca6..3f2bdbd 100644
--- a/src/egl/drivers/switch/egl_switch.c
+++ b/src/egl/drivers/switch/egl_switch.c
@@ -46,6 +46,7 @@
 
 #include "pipe/p_context.h"
 #include "pipe/p_screen.h"
+#include "util/disk_cache.h"
 #include "pipe/p_state.h"
 
 #include "util/u_atomic.h"
@@ -506,9 +507,28 @@ switch_initialize(_EGLDriver *drv, _EGLDisplay *dpy)
 
     display->stmgr = stmgr;
     display->stapi = st_gl_api_create();
+
+    // The shader cache has no directory on the Switch; offer it to the application instead.
+    if (stmgr->screen->get_disk_shader_cache &&
+        stmgr->screen->get_disk_shader_cache(stmgr->screen))
+        dpy->Extensions.ANDROID_blob_cache = EGL_TRUE;
     return EGL_TRUE;
 }
 
+// Called via eglSetBlobCacheFuncsANDROID(): compiled GLSL programs (and the "seen" marks for
+// their shaders) then go to the application's set/get functions.
+static void
+switch_set_blob_cache_funcs(_EGLDriver *drv, _EGLDisplay *dpy,
+                            EGLSetBlobFuncANDROID set, EGLGetBlobFuncANDROID get)
+{
+    struct switch_egl_display *display = switch_egl_display(dpy);
+    struct pipe_screen *screen = display->stmgr->screen;
+    struct disk_cache *cache = screen->get_disk_shader_cache ?
+        screen->get_disk_shader_cache(screen) : NULL;
+    if (cache)
+        disk_cache_set_callbacks(cache, set, get);
+}
+
 
 static EGLBoolean
 switch_terminate(_EGLDriver* drv, _EGLDisplay* dpy)
@@ -747,4 +767,5 @@ _eglInitDriver(_EGLDriver *driver)
     driver->API.SwapInterval = switch_swap_interval;
     driver->API.SwapBuffers = switch_swap_buffers;
     driver->API.GetProcAddress = switch_get_proc_address;
+    driver->API.SetBlobCacheFuncsANDROID = switch_set_blob_cache_funcs;
 }
diff --git a/src/gallium/drivers/nouveau/nouveau_screen.c b/src/gallium/drivers/nouveau/nouveau_screen.c
index 22fdb9f..564de8f 100644
